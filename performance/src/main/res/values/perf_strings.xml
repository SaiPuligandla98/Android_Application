<?xml version="1.0" encoding="utf-8"?>
<!--
 =============================================================================
  perf_strings.xml  |  User-visible text for the performance module
 =============================================================================

  Every resource is prefixed `perf_`. Library resources merge into the host
  app's table, so a bare name would collide; AGP enforces the prefix at build
  time via `resourcePrefix` in build.gradle.

  A host app can override any of these by declaring the same name in its own
  strings.xml - the app wins the merge. That is how the module is re-branded
  without forking it.
 =============================================================================
-->
