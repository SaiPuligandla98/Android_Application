<?xml version="1.0" encoding="utf-8"?>
<!--
 =============================================================================
  perf_dimens.xml  |  Sizes and spacing for the performance module
 =============================================================================

  The module carries its own scale rather than depending on the host app's
  dimension names, so it renders correctly when dropped into a project that
  happens not to define `spacing_medium`.

  A host app can still override any of these by declaring the same name; app
  resources win the merge.

  Touch target is 48dp: the accessibility minimum, roughly the contact area of
  an adult fingertip.
 =============================================================================
-->
<resources>

    <dimen name="perf_spacing_small">8dp</dimen>
    <dimen name="perf_spacing_medium">16dp</dimen>
    <dimen name="perf_spacing_large">20dp</dimen>

    <dimen name="perf_text_title">20sp</dimen>
    <dimen name="perf_text_body">15sp</dimen>
    <dimen name="perf_text_caption">12sp</dimen>

    <dimen name="perf_touch_target">48dp</dimen>
    <!-- ==================== Live graph cards ==================== -->
    <!-- Large enough to read across the room; this is the headline number. -->
    <dimen name="perf_text_live">28sp</dimen>
    <!-- Tall enough for the shape of a trend to be legible, short enough that
         both cards and the detail sections still fit on a landscape screen. -->
    <dimen name="perf_graph_height">48dp</dimen>
    <dimen name="perf_card_radius">10dp</dimen>
</resources>
