<?xml version="1.0" encoding="utf-8"?>
<!--
  perf_ic_back.xml  |  Material system icon.

  Vector rather than PNG: one file that stays crisp at every screen density,
  instead of five that must be regenerated whenever the artwork changes.

  Tinted from a THEME ATTRIBUTE, so it re-colours itself in dark mode with no
  second drawable and no code.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:autoMirrored="true"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurface">
    <path
        android:fillColor="#FF000000"
        android:pathData="M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z" />
</vector>