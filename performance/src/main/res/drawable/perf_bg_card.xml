<?xml version="1.0" encoding="utf-8"?>
<!--
  perf_bg_card.xml  |  Background for a live metric card.

  A bordered panel. The outline is what makes each card read as one object
  rather than as loose text sharing a screen, which matters when two sit side
  by side.

  Colours come from theme attributes, so the card follows light and dark mode
  with no second drawable.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutline" />
    <corners android:radius="@dimen/perf_card_radius" />
</shape>