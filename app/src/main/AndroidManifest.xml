<?xml version="1.0" encoding="utf-8"?>
<!--
 =============================================================================
  AndroidManifest.xml  |  The application's declaration to the Android OS
 =============================================================================

  PURPOSE
  =======
  Every Android app ships a manifest. The operating system reads it BEFORE any
  of our code runs, in order to learn:

    * what the app is called and which icon represents it,
    * which components (Activities, Services, Receivers) exist,
    * which of those components the launcher / other apps may start,
    * which permissions and hardware features the app requires.

  COMPONENTS DECLARED HERE
  ========================
    HcRoboticsApplication  Process-wide singleton, created before any Activity.
    SplashActivity         Launcher entry point. Shows branding, then routes on.
    MainActivity           The app's first real screen.

  NOTE ON `android:exported`
  ==========================
  Since Android 12 (API 31) every component with an <intent-filter> MUST state
  `exported` explicitly. Only SplashActivity is exported, because only it is
  started from outside our process (by the launcher). MainActivity is internal,
  so exporting it would needlessly widen the attack surface.
 =============================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".HcRoboticsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HCRobotics">

        <!--
          SplashActivity
          ==============
          The LAUNCHER intent-filter makes this the icon the user taps.

          `android:theme` points at the splash-specific theme whose
          windowBackground already contains the logo. That means the branded
          frame is drawn by the window manager the instant the process starts,
          eliminating the blank-white flash that would otherwise appear before
          onCreate() inflates a layout.

          `noHistory="true"` drops the splash from the back stack, so pressing
          Back on the main screen exits the app instead of returning to the
          splash.
        -->
        <!--
          ORIENTATION: sensorLandscape, on every Activity.

          The app is landscape-only, but "landscape" alone would pin it to ONE
          rotation, so turning the device the other way up leaves the interface
          upside down. `sensorLandscape` allows BOTH landscape rotations and
          follows the accelerometer between them, while never permitting
          portrait.

          That distinction matters on a device that gets picked up and put down
          from either side, which is exactly the case for field hardware.

          Declared per-Activity rather than on <application> because the
          attribute is not inherited - an Activity without it would silently
          allow portrait again.
        -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.HCRobotics.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          MainActivity
          ============
          The landing screen, started only by SplashActivity, hence exported=false.
        -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!--
          SettingsActivity
          ================
          Build information, update control and rollback. Reached from the gear
          icon on the main screen.

          `parentActivityName` declares MainActivity as its logical parent, so
          the system handles up-navigation and the back stack correctly even
          when the screen is entered from somewhere unusual, such as a
          notification.
        -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.main.MainActivity"
            android:screenOrientation="sensorLandscape" />

        <!--
          UpdateActivity belongs to the :updater LIBRARY, which is deliberately
          generic and takes no view on orientation - it has to work in portrait
          apps too.

          `tools:node="merge"` adds an attribute to a component declared
          elsewhere rather than redeclaring it. Without this the update screen
          would be the one place the app flipped to portrait, mid-update, which
          is exactly the wrong moment to disorient someone.

          This is the correct way for an app to constrain a library component:
          the library stays reusable, the app states its own requirement.
        -->
        <activity
            android:name="com.hcrobotics.updater.ui.UpdateActivity"
            android:screenOrientation="sensorLandscape"
            tools:node="merge" />

        <!--
          The feature modules' screens, constrained to landscape by the app.

          Like the updater, :performance and :appinsights are deliberately
          generic and take no view on orientation - they have to work in
          portrait apps too. `tools:node="merge"` adds the attribute to a
          component declared elsewhere rather than redeclaring it, so the
          libraries stay reusable while this app states its own requirement.

          Without these, opening either feature would be the one place the app
          flipped to portrait.
        -->
        <activity
            android:name="com.hcrobotics.performance.PerformanceActivity"
            android:screenOrientation="sensorLandscape"
            tools:node="merge" />

        <activity
            android:name="com.hcrobotics.appinsights.AppInsightsActivity"
            android:screenOrientation="sensorLandscape"
            tools:node="merge" />

    </application>

</manifest>
