<?xml version="1.0" encoding="utf-8"?>
<!--
 =============================================================================
  activity_main.xml  |  Layout for MainActivity = the dashboard
 =============================================================================

  WHAT CHANGED IN 1.8.0
  =====================
  The welcome message and the "HC Robotics" top-bar title are gone. The screen
  now exists to get the user somewhere rather than to greet them.

  A landing screen whose entire content is a sentence the user has already read
  is a screen they have to get past. Replacing it with the two things the app
  actually does means the first tap is useful rather than dismissive.

  STRUCTURE
      top bar     home and settings, unchanged
      cards       one per feature, filling the space below
      version     the running build, pinned to the bottom

  WHY CARDS RATHER THAN A LIST
  ============================
  There are two destinations and there will not be many more. A card carries an
  icon, a title AND a line explaining what the feature is for, which a list row
  cannot. At this count the extra space costs nothing.

  Each card is a LinearLayout with `selectableItemBackground` layered over its
  own background, so the whole card ripples on touch. That is what signals the
  entire area is tappable rather than only the text inside it.

  WHY THE CARDS SIT SIDE BY SIDE
  ==============================
  The app is landscape-only. Stacking vertically would leave most of a
  landscape screen empty while making each card wide and short.

  fitsSystemWindows is NOT cosmetic: targetSdk 35 forces edge-to-edge on
  Android 15, so without it the top bar's buttons sit under the system bars.
  In landscape the navigation bar takes the right edge, directly over the
  Settings button, which then stops responding while staying fully visible.
 =============================================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.main.MainActivity">

    <include
        android:id="@+id/top_bar"
        layout="@layout/view_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_cards"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_large"
        app:layout_constraintBottom_toTopOf="@id/text_app_version"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <!-- ==================== Device performance ==================== -->
        <LinearLayout
            android:id="@+id/card_performance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:layout_weight="1"
            android:background="@drawable/bg_dashboard_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <ImageView
                android:layout_width="@dimen/dashboard_icon_size"
                android:layout_height="@dimen/dashboard_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_speed"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/dashboard_performance_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:text="@string/dashboard_performance_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>

        <!-- ==================== Installed applications ==================== -->
        <LinearLayout
            android:id="@+id/card_apps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:background="@drawable/bg_dashboard_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <ImageView
                android:layout_width="@dimen/dashboard_icon_size"
                android:layout_height="@dimen/dashboard_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_apps"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/dashboard_apps_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:text="@string/dashboard_apps_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>

    </LinearLayout>

    <!--
      Running build.

      On a fleet that updates over the air, the first question when a device
      reports a problem is which build it is running, and this is the only way
      to answer it without physical access.
    -->
    <TextView
        android:id="@+id/text_app_version"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_size_caption"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Version 1.8.0 (build 9)" />

</androidx.constraintlayout.widget.ConstraintLayout>
