<?xml version="1.0" encoding="utf-8"?>
<!--
 =============================================================================
  activity_main.xml  |  Layout for MainActivity (the home screen)
 =============================================================================

  WHAT IS ON SCREEN
  =================
    * The shared top bar: Home on the left, Settings on the right.
    * The welcome message, centred in the space beneath it.
    * The running build version.

  THE LOGO HAS BEEN REMOVED FROM THIS SCREEN
  ==========================================
  It appeared here and on the splash screen, which meant the user saw the same
  wordmark twice within two seconds of opening the app. The splash is where
  branding belongs - it exists for exactly that - so showing it again on the
  landing screen added nothing and pushed the actual content down.

  STRUCTURE
  =========
      top bar          pinned to the top
      content block    centred in everything that remains

  The welcome text and version form a packed vertical chain constrained between
  the top bar and the bottom of the screen, so the pair sits centred in the
  remaining space rather than in the whole window - which would push it visibly
  low once the bar took its height.
 =============================================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.MainActivity">

    <!--
      Shared top bar. Defined once in view_top_bar.xml and included by every
      screen, so a change there applies everywhere.

      The id makes View Binding expose it as a nested binding, reached as
      binding.topBar.buttonHome.
    -->
    <include
        android:id="@+id/top_bar"
        layout="@layout/view_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      The welcome message. Head of a packed chain, constrained BELOW the top bar
      rather than to the parent, so it centres in the space that is actually
      left over.
    -->
    <TextView
        android:id="@+id/text_welcome_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_large"
        android:layout_marginEnd="@dimen/spacing_large"
        android:gravity="center"
        android:text="@string/main_welcome_message"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/text_size_headline"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/text_app_version"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintVertical_chainStyle="packed" />

    <!--
      Running build.

      On a fleet that updates over the air, the first question when a device
      reports a problem is always which build it is running. Putting the answer
      on screen turns that from a support conversation into a glance.
    -->
    <TextView
        android:id="@+id/text_app_version"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_large"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_welcome_message"
        tools:text="Version 1.5.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
