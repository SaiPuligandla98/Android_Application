<?xml version="1.0" encoding="utf-8"?>
<!--
 =============================================================================
  activity_settings.xml  |  Layout for SettingsActivity
 =============================================================================

  WHAT IS ON SCREEN
  =================
    * A header bar with a back arrow.
    * ABOUT      : app name, installed version, package id.
    * UPDATES    : update status, "Check for updates", rollback.

  WHY A SCROLLVIEW WRAPS EVERYTHING
  =================================
  A settings screen grows. Wrapping the content in a ScrollView from the start
  means adding a row later can never push the last one off the bottom of a small
  phone, and costs nothing while the content still fits.

  `fillViewport="true"` makes the child stretch to at least the screen height,
  so the background covers the full window even when there is little content.

  WHY EACH ROW IS A LinearLayout AND NOT A CUSTOM VIEW
  ====================================================
  Three rows do not justify a custom view or a RecyclerView adapter. The
  repetition is honest and every row is visible in one file. Extract a component
  when there are ten, not three.

  Rows use `?attr/selectableItemBackground` so they ripple on touch, which is
  what tells a user the whole row is tappable rather than just the text.
 =============================================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.settings.SettingsActivity">

    <!-- ==================== Header bar ==================== -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_small"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_action_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:text="@string/settings_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_extra_large">

            <!-- ==================== ABOUT ==================== -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_about" />

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_row_app_name" />

                <TextView
                    android:id="@+id/text_app_name_value"
                    style="@style/SettingsRowValue"
                    tools:text="HC Robotics" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_row_installed_version" />

                <TextView
                    android:id="@+id/text_installed_version_value"
                    style="@style/SettingsRowValue"
                    tools:text="1.3.0 (build 4)" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_row_package" />

                <TextView
                    android:id="@+id/text_package_value"
                    style="@style/SettingsRowValue"
                    tools:text="com.hcrobotics.testapp" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- ==================== UPDATES ==================== -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_updates" />

            <!--
              Update status. Tappable ONLY when an update is actually waiting;
              SettingsActivity toggles isEnabled, and a disabled row does not
              ripple, which is the honest signal that there is nothing to tap.
            -->
            <LinearLayout
                android:id="@+id/row_update"
                style="@style/SettingsRowClickable">

                <TextView
                    android:id="@+id/text_update_title"
                    style="@style/SettingsRowTitle"
                    tools:text="Update available" />

                <TextView
                    android:id="@+id/text_update_subtitle"
                    style="@style/SettingsRowValue"
                    tools:text="Version 1.3.0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_check_updates"
                style="@style/SettingsRowClickable">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_row_check_updates" />

                <TextView
                    android:id="@+id/text_last_checked"
                    style="@style/SettingsRowValue"
                    tools:text="Checks automatically every 6 hours" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- ==================== ROLLBACK ==================== -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_rollback" />

            <LinearLayout
                android:id="@+id/row_rollback"
                style="@style/SettingsRowClickable">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_row_rollback" />

                <TextView
                    android:id="@+id/text_rollback_subtitle"
                    style="@style/SettingsRowValue"
                    tools:text="Go back to version 1.2.0" />
            </LinearLayout>

            <!--
              Standing warning about downgrades. Present even when rollback is
              available, because the constraint is a platform rule the user
              cannot change and should not meet for the first time as an error
              message halfway through.
            -->
            <TextView
                android:id="@+id/text_rollback_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_large"
                android:paddingTop="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_large"
                android:text="@string/settings_rollback_note"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
