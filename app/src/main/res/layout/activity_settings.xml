<?xml version="1.0" encoding="utf-8"?>
<!--
 =============================================================================
  activity_settings.xml  |  Layout for SettingsActivity
 =============================================================================

  MODELLED ON ANDROID'S OWN "SYSTEM UPDATE" SCREEN
  ================================================
  Every mature updater - Android System Update, Chrome, Windows Update - uses
  the same shape, because it answers the user's questions in the order they ask
  them:

     1. "Am I up to date?"          -> one prominent status line
     2. "How do you know?"          -> when it was last checked
     3. "Let me look again"         -> an explicit check button
     4. "What would I be getting?"  -> details, ONLY when there is something
     5. "Something went wrong"      -> problems, ONLY when there are any
     6. "I need to go back"         -> rollback, tucked below the fold

  The ordering is the design. Status first because it is the only thing most
  visits need; rollback last because wanting it is rare and doing it by accident
  is bad.

  SECTIONS THAT HIDE THEMSELVES
  =============================
  `card_update_details`, `row_notifications_warning` and `row_install_warning`
  are `visibility="gone"` by default and revealed by SettingsActivity only when
  they apply. A screen that always shows every possible row forces the user to
  work out which ones matter today; one that shows only what is true reads as a
  short screen with a clear answer.
 =============================================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.settings.SettingsActivity">

    <!--
      The same shared top bar as the home screen.

      Home on the left returns to MainActivity from here, which is the whole
      point of it being permanent: the way back is in the identical place on
      every screen, so it never has to be looked for.
    -->
    <include
        android:id="@+id/top_bar"
        layout="@layout/view_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      `focusableInTouchMode` fixes a real and easily-missed bug.

      On layout, a ScrollView scrolls to whichever descendant takes initial
      focus. Because the rows below are focusable (they must be, for keyboard
      and TalkBack), the screen opened already scrolled PAST the status block -
      the single most important thing on it - straight to a row further down.
      Observed on a real device: the screen opened showing "ADVANCED".

      Making the ScrollView itself focusable in touch mode means IT takes the
      initial focus, so the screen opens at the top where it should. The rows
      stay individually focusable, so nothing about accessibility is lost.
    -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:focusableInTouchMode="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_extra_large">

            <!-- ============================================================
                 1. STATUS  -  the answer to "am I up to date?"
                 ============================================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_large"
                android:paddingTop="@dimen/spacing_extra_large"
                android:paddingEnd="@dimen/spacing_large"
                android:paddingBottom="@dimen/spacing_large">

                <ImageView
                    android:id="@+id/image_status"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorPrimary" />

                <!-- The one line most visits are here to read. -->
                <TextView
                    android:id="@+id/text_status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_size_headline"
                    android:textStyle="bold"
                    tools:text="Your app is up to date" />

                <!-- Proof: which version, and when we last actually asked. -->
                <TextView
                    android:id="@+id/text_status_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_size_body"
                    tools:text="Version 1.4.0 (build 5)\nLast checked: 2 minutes ago" />

                <Button
                    android:id="@+id/button_check_updates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/settings_row_check_updates"
                    android:textAllCaps="false" />

            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- ============================================================
                 2. UPDATE DETAILS  -  shown ONLY when an update is waiting
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/card_update_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/SettingsSectionHeader"
                    android:text="@string/settings_section_available_update" />

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        android:id="@+id/text_available_version"
                        style="@style/SettingsRowTitle"
                        android:textStyle="bold"
                        tools:text="Version 1.5.0" />

                    <TextView
                        android:id="@+id/text_available_size"
                        style="@style/SettingsRowValue"
                        tools:text="Download size: 5.8 MB" />

                    <TextView
                        android:id="@+id/text_available_notes"
                        style="@style/SettingsRowValue"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingMultiplier="1.2"
                        tools:text="What's new\n• Faster startup" />

                    <Button
                        android:id="@+id/button_install_update"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/settings_action_download_install"
                        android:textAllCaps="false" />

                </LinearLayout>

                <View style="@style/SettingsDivider" />
            </LinearLayout>

            <!-- ============================================================
                 3. PROBLEMS  -  each row appears only when it is true
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/row_notifications_warning"
                style="@style/SettingsRowClickable"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_notifications_off_title"
                    android:textColor="@color/brand_orange" />

                <TextView
                    style="@style/SettingsRowValue"
                    android:text="@string/settings_notifications_off_subtitle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_install_warning"
                style="@style/SettingsRowClickable"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_install_permission_title"
                    android:textColor="@color/brand_orange" />

                <TextView
                    style="@style/SettingsRowValue"
                    android:text="@string/settings_install_permission_subtitle" />
            </LinearLayout>

            <!-- ============================================================
                 4. NOTIFICATIONS
                 ============================================================ -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_notifications" />

            <LinearLayout
                android:id="@+id/row_notifications"
                style="@style/SettingsRowClickable">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_row_notifications" />

                <TextView
                    android:id="@+id/text_notifications_state"
                    style="@style/SettingsRowValue"
                    tools:text="Enabled — you will be told when an update is ready" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <!-- ============================================================
                 5. ADVANCED  -  rollback, deliberately last
                 ============================================================ -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_advanced" />

            <LinearLayout
                android:id="@+id/row_rollback"
                style="@style/SettingsRowClickable">

                <TextView
                    android:id="@+id/text_rollback_title"
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_row_rollback" />

                <TextView
                    android:id="@+id/text_rollback_subtitle"
                    style="@style/SettingsRowValue"
                    tools:text="Go back to version 1.3.0" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_rollback_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_large"
                android:paddingTop="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_large"
                android:text="@string/settings_rollback_note"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_size_caption" />

            <View style="@style/SettingsDivider" />

            <!-- ============================================================
                 6. ABOUT
                 ============================================================ -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_about" />

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_row_app_name" />

                <TextView
                    android:id="@+id/text_app_name_value"
                    style="@style/SettingsRowValue"
                    tools:text="HC Robotics" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:text="@string/settings_row_package" />

                <TextView
                    android:id="@+id/text_package_value"
                    style="@style/SettingsRowValue"
                    tools:text="com.hcrobotics.testapp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
