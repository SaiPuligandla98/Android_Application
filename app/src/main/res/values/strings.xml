<?xml version="1.0" encoding="utf-8"?>
<!--
 =============================================================================
  strings.xml  |  Every user-visible string in the application
 =============================================================================

  RULE: no user-facing text is ever hard-coded in Java or in a layout. It all
  lives here.

  WHY THIS RULE EARNS ITS KEEP
  ============================
  * Translation. Adding Hindi is `values-hi/strings.xml` with the same keys —
    no source file is touched, so no logic can regress.
  * Consistency. A term is defined once, so it cannot drift between screens.
  * Review. A copy change is a diff in one file, readable by a non-programmer.
  * Accessibility. Content descriptions read by TalkBack live beside
    the visible copy, so they are far less likely to be forgotten.

  NAMING CONVENTION
  =================
    <screen>_<purpose>       e.g. splash_version_format
    cd_<thing>               content description, for screen readers only
    Suffix `_format` marks a string containing printf-style placeholders.
 =============================================================================
-->
<resources>

    <!--
      The application name, shown under the launcher icon, in the app switcher
      and throughout system Settings. Referenced by android:label in the manifest.
    -->
    <string name="app_name">HC Robotics</string>

    <!-- ==================== Splash screen ==================== -->

    <!--
      Build version shown in the bottom corner of the splash screen.
      %1$s is substituted with BuildConfig.VERSION_NAME at runtime.
      The positional form (%1$s rather than %s) is required so translators can
      reorder placeholders freely.
    -->
    <string name="splash_version_format">Version %1$s</string>

    <!--
      Spoken by TalkBack in place of the logo image. Describes what the image
      conveys, not what it literally is — never "logo image" or "picture of".
    -->
    <string name="cd_company_logo">HC Robotics company logo</string>

    <!-- ==================== Main screen ==================== -->

    <!-- The landing screen's welcome message. -->
    <string name="main_welcome_message">Welcome to HC Robotics Android Application</string>

    <!--
      Running build, shown beneath the welcome message.

      Shows the version NAME and the version CODE together.
      %1$s = BuildConfig.VERSION_NAME, %2$d = BuildConfig.VERSION_CODE.

      Both matter, and for different reasons. The name is what a person
      reports ("I'm on 1.7.0"). The code is what actually decides whether an
      update applies - the check is strictly
      `manifest.versionCode > installed versionCode`.

      When an update does not arrive, the first useful question is "what code
      is that device on?", and on a remote fleet this is the only way to answer
      it without physical access.
    -->
    <string name="main_version_format">Version %1$s (build %2$d)</string>

    <!-- Button that runs an update check immediately. -->
    <string name="main_action_check_updates">Check for updates</string>

    <!-- Confirmation shown after tapping that button. -->
    <string name="main_update_check_started">Checking for updates…</string>

    <!-- Shown when a check finds the app is already current. -->
    <string name="main_update_none">You are on the latest version.</string>

    <!-- Content description for the settings icon, read aloud by TalkBack. -->
    <string name="main_action_settings">Settings</string>

    <!-- ==================== Top bar ==================== -->

    <!-- Content description for the home button, read aloud by TalkBack. -->
    <string name="top_bar_action_home">Home</string>

    <!-- Title shown in the top bar on the home screen. -->
    <string name="top_bar_title_home">HC Robotics</string>

    <!-- ==================== Settings screen ==================== -->

    <string name="settings_title">Settings</string>
    <string name="settings_action_back">Back</string>

    <string name="settings_section_about">ABOUT</string>
    <string name="settings_row_app_name">Application</string>
    <string name="settings_row_installed_version">Installed version</string>
    <string name="settings_row_package">Package</string>

    <!--
      Version name AND version code together. The name is what a user reports;
      the code is what actually decides whether an update applies. Showing both
      makes "why isn't it updating?" answerable at a glance.
      %1$s = version name, %2$d = version code.
    -->
    <string name="settings_version_format">%1$s (build %2$d)</string>

    <!-- ==================== Status block ==================== -->

    <string name="settings_row_check_updates">Check for updates</string>

    <!-- The headline answer. -->
    <string name="settings_status_up_to_date">Your app is up to date</string>
    <string name="settings_status_update_available">Update available</string>
    <string name="settings_status_checking">Checking for updates…</string>

    <!--
      Supporting detail beneath the headline.
      %1$s = version name, %2$d = version code, %3$s = last-checked phrase.
    -->
    <string name="settings_status_detail_format">Version %1$s (build %2$d)\nLast checked: %3$s</string>

    <!--
      Relative times. Absolute timestamps ("14:32 on 15 Aug") make the reader do
      arithmetic; "3 minutes ago" is the answer they actually wanted.
    -->
    <string name="settings_last_checked_never">never</string>
    <string name="settings_last_checked_just_now">just now</string>
    <string name="settings_last_checked_minutes">%1$d minutes ago</string>
    <string name="settings_last_checked_hours">%1$d hours ago</string>
    <string name="settings_last_checked_days">%1$d days ago</string>

    <!-- ==================== Available update ==================== -->

    <string name="settings_section_available_update">AVAILABLE UPDATE</string>
    <string name="settings_available_version_format">Version %1$s</string>
    <string name="settings_available_size_format">Download size: %1$s</string>
    <string name="settings_action_download_install">Download and install</string>

    <!-- ==================== Problems ==================== -->

    <!--
      Surfaced only when true. Both of these fail SILENTLY on a device, so
      naming them here is the only way a user ever finds out.
    -->
    <string name="settings_notifications_off_title">Notifications are turned off</string>
    <string name="settings_notifications_off_subtitle">You will not be told when an update is ready. Tap to turn them on.</string>

    <string name="settings_install_permission_title">Installing updates is not allowed</string>
    <string name="settings_install_permission_subtitle">Android needs permission before this app can install an update. Tap to grant it.</string>

    <!-- ==================== Appearance ==================== -->

    <string name="settings_section_appearance">APPEARANCE</string>

    <!--
      "System" is listed first and is the default. It is the option most people
      actually want: the app darkens in the evening along with everything else
      on the phone, with no further thought.
    -->
    <string name="settings_theme_system">Use device setting</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>

    <string name="settings_theme_note">The theme changes immediately and is remembered the next time the app opens.</string>

    <!-- ==================== Notifications ==================== -->

    <string name="settings_section_notifications">NOTIFICATIONS</string>
    <string name="settings_row_notifications">Update notifications</string>
    <string name="settings_notifications_enabled">Enabled — you will be told when an update is ready</string>
    <string name="settings_notifications_disabled">Disabled — tap to turn on</string>

    <!-- ==================== Advanced / rollback ==================== -->

    <string name="settings_section_advanced">ADVANCED</string>
    <string name="settings_row_rollback">Go back one version</string>
    <string name="settings_rollback_version_format">Restore version %1$s</string>
    <string name="settings_rollback_unavailable">Not available. A rollback needs an earlier published version to return to.</string>

    <!--
      Standing warning, shown whenever rollback is available. The constraint is
      a platform rule the user cannot change, and it is far better met here than
      as an error halfway through an install.
    -->
    <string name="settings_rollback_note">Note: Android only allows installing an older version over a newer one for debuggable builds. On a signed release build the app must be uninstalled first, which erases its saved data.</string>
    <!-- ==================== Dashboard ==================== -->
    <!--
      Each card states what the feature IS on the first line and what it is FOR
      on the second. A title alone makes the user tap to find out.
    -->
    <string name="dashboard_performance_title">Performance</string>
    <string name="dashboard_performance_subtitle">Memory, storage, battery and network, live</string>
    <string name="dashboard_apps_title">Applications</string>
    <string name="dashboard_apps_subtitle">What is installed on this device</string>
</resources>
