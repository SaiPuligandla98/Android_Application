<?xml version="1.0" encoding="utf-8"?>
<!--
 =============================================================================
  dimens.xml  |  Named sizes, spacings and type scale
 =============================================================================

  WHY NAMED DIMENSIONS INSTEAD OF INLINE VALUES
  =============================================
  * A tablet or landscape layout can override one value here
    (values-sw600dp/dimens.xml) without duplicating a single layout file.
  * Spacing stays on a consistent 8dp rhythm instead of drifting into a mix of
    13dp, 15dp and 18dp across screens.
  * A design-system change becomes one reviewable diff.

  dp VS sp : USE THE RIGHT UNIT
  =============================
  dp (density-independent pixels): all layout sizes and spacing. Scales with
      screen density so a 16dp margin is physically the same on every device.
  sp (scale-independent pixels): text sizes ONLY. Behaves like dp but ALSO
      honours the user's system font-size setting. Using dp for text silently
      breaks accessibility for anyone who has enlarged their system font.
 =============================================================================
-->
<resources>

    <!-- ==================== Spacing scale (8dp rhythm) ==================== -->
    <dimen name="spacing_extra_small">4dp</dimen>
    <dimen name="spacing_small">8dp</dimen>
    <dimen name="spacing_medium">16dp</dimen>
    <dimen name="spacing_large">24dp</dimen>
    <dimen name="spacing_extra_large">32dp</dimen>

    <!-- ==================== Type scale ==================== -->
    <dimen name="text_size_caption">12sp</dimen>
    <dimen name="text_size_body">16sp</dimen>
    <dimen name="text_size_headline">22sp</dimen>

    <!-- ==================== Splash screen ==================== -->
    <!--
      Logo dimensions. The source artwork is 1164x220 px (an aspect ratio of
      5.29:1); 260dp x 49dp preserves that ratio exactly, so the wordmark is
      never stretched.

      These same two values are used by drawable/bg_splash.xml, which guarantees
      the pre-inflation window background and the inflated layout place the logo
      at an identical size — that is what makes the hand-off invisible.
    -->
    <dimen name="splash_logo_width">260dp</dimen>
    <dimen name="splash_logo_height">49dp</dimen>

    <!-- ==================== Main screen ==================== -->
    <!--
      Caps the brand mark's width so it stays a logo rather than a banner on a
      tablet. Height follows automatically from adjustViewBounds and the
      artwork's 1164x220 aspect ratio.
    -->
    <dimen name="main_logo_max_width">280dp</dimen>

    <!--
      Minimum height for any tappable control: the accessibility guideline
      minimum, roughly the contact area of an adult fingertip. Smaller targets
      are measurably harder to hit, especially one-handed.
    -->
    <dimen name="touch_target_min">48dp</dimen>

    <!--
      The update dot on the settings gear. 10dp is the smallest size that stays
      unmistakably a deliberate indicator rather than a rendering artefact,
      while remaining quiet enough not to compete with the icon it sits on.
    -->
    <dimen name="update_badge_size">10dp</dimen>

    <!-- Corner radius of the outlined top-bar icon buttons. -->
    <dimen name="icon_button_corner_radius">8dp</dimen>

</resources>
