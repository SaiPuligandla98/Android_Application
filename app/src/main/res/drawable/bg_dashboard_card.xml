<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_dashboard_card.xml  |  Background for a dashboard card.

  A bordered panel that ripples when pressed. The outline is what makes the
  card read as one tappable object rather than a loose group of views.

  State list order matters: items are matched top to bottom and the first hit
  wins, so the unconditional default must be LAST.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceVariant" />
            <stroke android:width="1dp" android:color="?attr/colorPrimary" />
            <corners android:radius="@dimen/dashboard_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="?attr/colorOutline" />
            <corners android:radius="@dimen/dashboard_card_radius" />
        </shape>
    </item>
</selector>