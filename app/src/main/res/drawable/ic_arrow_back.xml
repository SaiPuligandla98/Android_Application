<?xml version="1.0" encoding="utf-8"?>
<!--
 =============================================================================
  ic_arrow_back.xml  |  Back arrow for the Settings screen
 =============================================================================

  `android:autoMirrored="true"` is the important attribute. In a right-to-left
  locale such as Arabic or Hebrew, "back" points the other way, and the system
  flips this drawable automatically because of that one flag. Without it the
  arrow points confidently in the wrong direction for a large part of the world.
 =============================================================================
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:autoMirrored="true"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurface">

    <path
        android:fillColor="#FF000000"
        android:pathData="M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z" />

</vector>
